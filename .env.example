# ============================================================
#  Biến môi trường dùng chung cho dev (copy sang .env để chạy)
#  Khi chạy trong Docker, override DB_HOST=postgres,
#  RABBITMQ_HOST=rabbitmq, KAFKA_BROKERS=kafka:9092
# ============================================================

NODE_ENV=development

# --- PostgreSQL (shared instance, database-per-service) ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_LOGGING=false

# --- RabbitMQ (command / request-reply) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# --- Kafka (domain events) ---
KAFKA_BROKERS=localhost:9092

# --- Distributed tracing (OpenTelemetry -> Jaeger) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENABLED=false

# --- API Gateway ---
PORT=8080

# --- Auth ---
JWT_SECRET=super-secret-dev-key-change-me
JWT_EXPIRES_IN=1h

# --- Payment service: tỉ lệ fail giả lập (0..1) để demo saga rollback ---
PAYMENT_FAIL_RATE=0.2
